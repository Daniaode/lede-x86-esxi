#!/bin/sh /etc/rc.common
# Periodic release check for the LEDE online updater.
#
# Only refreshes /var/run/online-update-status. It never downloads or
# flashes anything by itself; that requires an explicit user action in LuCI.

START=95
USE_PROCD=1

PROG=/usr/sbin/online-update
STATUS=/var/run/online-update-status
FAILFILE=/var/run/online-update-fails

# The loop is inlined because procd runs the command in a child shell where
# functions defined in this file are not visible.
RUNLOOP='
sleep 60
while :; do
	out=$('"$PROG"' check 2>/dev/null)
	rc=$?
	if [ "$rc" -ne 0 ]; then
		n=$(cat '"$FAILFILE"' 2>/dev/null || echo 0)
		n=$((n + 1))
		echo "$n" > '"$FAILFILE"'
		logger -t online-update "check failed rc=$rc consecutive=$n"
		out="RESULT=error
UPDATE_AVAILABLE=0
FAILS=$n"
	else
		rm -f '"$FAILFILE"'
	fi
	{
		echo "CHECKED_AT=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
		echo "$out"
	} > '"$STATUS"'
	h=$(uci -q get online-update.main.auto_check_hours)
	[ -z "$h" ] && h=24
	n=$(cat '"$FAILFILE"' 2>/dev/null || echo 0)
	[ "${n:-0}" -ge 3 ] && h=48
	sleep $((h * 3600))
done
'

start_service() {
	[ "$(uci -q get online-update.main.check_enabled)" = "1" ] || return 0

	procd_open_instance
	procd_set_param command /bin/sh -c "$RUNLOOP"
	procd_set_param respawn 3600 5 0
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "online-update"
}
