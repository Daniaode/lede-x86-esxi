diff --git a/net/mwan3/files/etc/uci-defaults/mwan3-fix-track-ips b/net/mwan3/files/etc/uci-defaults/mwan3-fix-track-ips
new file mode 100755
index 0000000..0dfba07
--- /dev/null
+++ b/net/mwan3/files/etc/uci-defaults/mwan3-fix-track-ips
@@ -0,0 +1,46 @@
+#!/bin/sh
+# Replace the legacy default tracking targets on upgrade.
+#
+# The old defaults (1.1.1.1 / 208.67.x.x) are unreachable by ICMP on many
+# Chinese networks, so mwan3track reported the WAN as flapping even while the
+# link was fine. /etc/config/mwan3 is a conffile and survives sysupgrade, so a
+# fresh default alone would never reach existing installs -- this migrates
+# them once.
+#
+# Only acts when the list is still exactly the legacy set; anything the user
+# customised is left alone.
+
+[ -f /etc/config/mwan3 ] || exit 0
+
+NEW="8.8.8.8 1.0.0.1 9.9.9.9 94.140.14.14"
+
+changed=0
+
+for section in $(uci -q show mwan3 | sed -n "s/^mwan3\.\([^.=]*\)=interface$/\1/p"); do
+	family=$(uci -q get "mwan3.$section.family")
+	[ "$family" = "ipv4" ] || continue
+
+	cur=$(uci -q get "mwan3.$section.track_ip")
+	[ -n "$cur" ] || continue
+
+	# normalise whitespace for comparison
+	norm=$(echo "$cur" | tr -s ' ' | sed 's/^ //;s/ $//')
+
+	case "$norm" in
+		"1.0.0.1 1.1.1.1 208.67.222.222 208.67.220.220")
+			uci -q delete "mwan3.$section.track_ip"
+			for ip in $NEW; do
+				uci -q add_list "mwan3.$section.track_ip=$ip"
+			done
+			changed=1
+			logger -t mwan3-migrate "updated track_ip on $section"
+			;;
+	esac
+done
+
+[ "$changed" -eq 1 ] && {
+	uci -q commit mwan3
+	/etc/init.d/mwan3 restart >/dev/null 2>&1
+}
+
+exit 0
