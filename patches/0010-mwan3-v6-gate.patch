diff --git a/net/mwan3/files/etc/uci-defaults/mwan3-fix-track-ips b/net/mwan3/files/etc/uci-defaults/mwan3-fix-track-ips
new file mode 100755
index 0000000..b4af782
--- /dev/null
+++ b/net/mwan3/files/etc/uci-defaults/mwan3-fix-track-ips
@@ -0,0 +1,104 @@
+#!/bin/sh
+# Normalise mwan3 tracking on upgrade.
+#
+# /etc/config/mwan3 is a conffile: sysupgrade preserves it, so a new default
+# never reaches an existing install. This migrates the known-bad shapes once
+# and then leaves the file alone.
+#
+# Three problems are handled.
+#
+# 1. Unreachable targets. The stock list is 1.0.0.1 / 1.1.1.1 / 208.67.x.x,
+#    and the OpenDNS resolvers do not answer ICMP on many Chinese networks,
+#    so mwan3track reported the link as flapping while it was fine.
+#
+# 2. Foreign targets that flap. A later build used 8.8.8.8 / 1.0.0.1 /
+#    9.9.9.9 / 94.140.14.14. Those answer ICMP here, but a single lossy hop
+#    still produces failed/recovered pairs on a healthy link. Domestic
+#    resolvers are simply more stable from a Chinese WAN.
+#
+# 3. reliability > target count. This is the fatal one and it is silent:
+#    mwan3 needs `reliability` targets up before the interface counts as
+#    online, so a one-target list with reliability 2 keeps the interface
+#    permanently offline even though every probe succeeds. Seen in the wild
+#    after a user narrowed track_ip by hand and left reliability at 2.
+#
+# 4. Foreign IPv6 targets. The shipped IPv6 list was Cloudflare/Facebook
+#    (2606:4700:4700::*, 2620:0:ccd::*, 2620:0:ccc::*). Those do not answer from
+#    a Chinese WAN, so an enabled wan6 stays down and the IPv6 policy resolves
+#    ::/0 to unreachable again.
+#
+# Anything the user customised beyond these exact shapes is left untouched.
+
+[ -f /etc/config/mwan3 ] || exit 0
+
+NEW="223.5.5.5 119.29.29.29 180.76.76.76 1.2.4.8"
+NEW6="2400:3200::1 2400:3200:baba::1 240c::6666"
+OLD6="2606:4700:4700::1001 2606:4700:4700::1111 2620:0:ccd::2 2620:0:ccc::2"
+
+changed=0
+
+replace_list() {
+	local section="$1"
+	uci -q delete "mwan3.$section.track_ip"
+	for ip in $NEW; do
+		uci -q add_list "mwan3.$section.track_ip=$ip"
+	done
+	logger -t mwan3-migrate "replaced track_ip on $section with domestic targets"
+	changed=1
+}
+
+for section in $(uci -q show mwan3 | sed -n "s/^mwan3\.\([^.=]*\)=interface$/\1/p"); do
+	family=$(uci -q get "mwan3.$section.family")
+
+	# IPv6 sections carry their own list; treat everything else as IPv4.
+	if [ "$family" = "ipv6" ]; then
+		cur6=$(uci -q get "mwan3.$section.track_ip")
+		[ -n "$cur6" ] || continue
+		norm6=$(echo "$cur6" | tr -s " " | sed "s/^ //;s/ $//")
+		[ "$norm6" = "$OLD6" ] || continue
+		uci -q delete "mwan3.$section.track_ip"
+		for ip in $NEW6; do
+			uci -q add_list "mwan3.$section.track_ip=$ip"
+		done
+		logger -t mwan3-migrate "replaced IPv6 track targets on $section"
+		changed=1
+		continue
+	fi
+
+	[ "$family" = "ipv4" ] || continue
+
+	cur=$(uci -q get "mwan3.$section.track_ip")
+	[ -n "$cur" ] || continue
+
+	# normalise whitespace for comparison
+	norm=$(echo "$cur" | tr -s " " | sed "s/^ //;s/ $//")
+	n=$(echo "$norm" | wc -w)
+
+	case "$norm" in
+		# stock upstream list
+		"1.0.0.1 1.1.1.1 208.67.222.222 208.67.220.220")
+			replace_list "$section"
+			continue
+			;;
+		# foreign list shipped by v8/v9
+		"8.8.8.8 1.0.0.1 9.9.9.9 94.140.14.14")
+			replace_list "$section"
+			continue
+			;;
+	esac
+
+	# A short list with an unreachable reliability is dead even if the user
+	# picked the targets deliberately, so widen it rather than trust them.
+	rel=$(uci -q get "mwan3.$section.reliability")
+	if [ -n "$rel" ] && [ "$n" -lt "$rel" ]; then
+		replace_list "$section"
+		continue
+	fi
+done
+
+[ "$changed" -eq 1 ] && {
+	uci -q commit mwan3
+	/etc/init.d/mwan3 restart >/dev/null 2>&1
+}
+
+exit 0
diff --git a/net/mwan3/files/lib/mwan3/common.sh b/net/mwan3/files/lib/mwan3/common.sh
index df42a0a..3fb5e76 100644
--- a/net/mwan3/files/lib/mwan3/common.sh
+++ b/net/mwan3/files/lib/mwan3/common.sh
@@ -22,6 +22,34 @@ MAX_SLEEP=$(((1<<31)-1))
 command -v ip6tables > /dev/null
 NO_IPV6=$?
 
+# Do not hijack IPv6 that is not ours to manage.
+#
+# The policy chains mark every unmarked ::/0 packet MMX_UNREACHABLE, and a
+# matching `ip -6 rule ... unreachable` drops it in the routing layer before any
+# firewall decision. That behaviour is right only while an IPv6 interface is
+# actually managed here.
+#
+# /etc/config/mwan3 is a conffile, so an upgraded install keeps the shipped
+# `wan6` at `enabled 0`. mwan3 then owns no IPv6 interface yet still blackholes
+# all of it: the router holds a valid upstream prefix and cannot reach a single
+# address. The same happens on a fresh install if the operator leaves wan6 off.
+#
+# Treat "no enabled IPv6 interface" exactly like "no ip6tables": skip every IPv6
+# rule and let the kernel route IPv6 normally. Enabling wan6 later restarts the
+# daemon, which re-evaluates this.
+if [ "$NO_IPV6" -eq 0 ]; then
+	mwan3_has_v6_iface() {
+		local s
+		for s in $(uci -q show mwan3 2>/dev/null |
+				sed -n "s/^mwan3\.\([^.=]*\)=interface$/\1/p"); do
+			[ "$(uci -q get "mwan3.$s.family")" = "ipv6" ] || continue
+			[ "$(uci -q get "mwan3.$s.enabled")" = "1" ] && return 0
+		done
+		return 1
+	}
+	mwan3_has_v6_iface || NO_IPV6=1
+fi
+
 IPS="ipset"
 IPT4="iptables -t mangle -w"
 IPT6="ip6tables -t mangle -w"
