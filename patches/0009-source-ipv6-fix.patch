diff --git a/package/base-files/files/bin/config_generate b/package/base-files/files/bin/config_generate
index c5e0a7b..70035ca 100755
--- a/package/base-files/files/bin/config_generate
+++ b/package/base-files/files/bin/config_generate
@@ -5,6 +5,40 @@ CFG=/etc/board.json
 . /usr/share/libubox/jshn.sh
 
 [ -s $CFG ] || /bin/board_detect || exit 1
+
+repair_pppoe_v6_sibling() {
+	local x dev6
+
+	for x in $(uci -q show network 2>/dev/null | sed -n "s/^network\.\([^.=]*\)=interface$/\1/p"); do
+		[ "$(uci -q get "network.$x.proto")" = "pppoe" ] || continue
+		uci -q get "network.${x}6" >/dev/null 2>&1 || continue
+
+		dev6=$(uci -q get "network.${x}6.device")
+		if [ "$dev6" != "@$x" ]; then
+			uci -q set "network.${x}6.device=@$x"
+			uci -q set "network.${x}6.proto=dhcpv6"
+			logger -t config_generate "rebound ${x}6 from ${dev6:-unset} to @$x (pppoe)"
+		fi
+
+		if [ -z "$(uci -q get "network.$x.ipv6")" ]; then
+			uci -q set "network.$x.ipv6=1"
+			logger -t config_generate "set $x.ipv6=1 (no dynamic ${x}_6)"
+		fi
+	done
+}
+
+repair_lan_ip6assign() {
+	[ -e /proc/sys/net/ipv6 ] || return 0
+	[ "$(uci -q get network.lan.proto)" = "static" ] || return 0
+	[ -n "$(uci -q get network.lan.ip6assign)" ] && return 0
+
+	uci -q set network.lan.ip6assign=60
+	logger -t config_generate "set network.lan.ip6assign=60"
+}
+
+repair_pppoe_v6_sibling
+repair_lan_ip6assign
+uci commit
 [ -s /etc/config/network -a -s /etc/config/system ] && exit 0
 
