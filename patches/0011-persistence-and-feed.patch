diff --git a/package/base-files/files/etc/opkg/kiddin9.conf b/package/base-files/files/etc/opkg/kiddin9.conf
new file mode 100644
index 000000000..c052ab0f0
--- /dev/null
+++ b/package/base-files/files/etc/opkg/kiddin9.conf
@@ -0,0 +1,10 @@
+# kiddin9 community feed (https://dl.openwrt.ai)
+#
+# Kept as a separate file rather than appended to distfeeds.conf: that file is
+# regenerated by FeedSourcesAppendOPKG on every build, so an appended line
+# would be silently dropped. opkg reads every *.conf under /etc/opkg/, which
+# was verified on a live device (the list was fetched and cached).
+#
+# This feed is unsigned by the build key, so installing from it needs
+# --force-signature on images that keep option check_signature.
+src/gz kiddin9 https://dl.openwrt.ai/latest/packages/x86_64/kiddin9
diff --git a/package/base-files/files/lib/upgrade/keep.d/ddns-go b/package/base-files/files/lib/upgrade/keep.d/ddns-go
new file mode 100644
index 000000000..522834316
--- /dev/null
+++ b/package/base-files/files/lib/upgrade/keep.d/ddns-go
@@ -0,0 +1,5 @@
+# ddns-go stores its real settings (domains, credentials, IP source) in
+# /etc/ddns-go/config.yaml. The package declares no conffiles and ships no
+# keep.d, and /etc/config/ is kept wholesale only for the UCI shell, so an
+# upgrade used to drop every DDNS task while leaving the enable switch on.
+/etc/ddns-go/
diff --git a/package/base-files/files/lib/upgrade/keep.d/smartdns b/package/base-files/files/lib/upgrade/keep.d/smartdns
new file mode 100644
index 000000000..d71de87af
--- /dev/null
+++ b/package/base-files/files/lib/upgrade/keep.d/smartdns
@@ -0,0 +1,4 @@
+# smartdns keeps user rules in /etc/smartdns/ (custom.conf, conf.d, ip-set,
+# domain-set). address.conf and friends are package defaults, but the whole
+# directory is kept so operator rules survive an upgrade.
+/etc/smartdns/
